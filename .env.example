# ---- 必填 ----
# 凭证加密主密钥：openssl rand -hex 32
# ★ 必须长期保存！弄丢之后数据库里的游戏密码 / Cookie / 推送 SendKey 全部无法解密。
MASTER_KEY=

# ---- 监听 ----
PORT=8580
# 本地裸跑建议 127.0.0.1；Docker 里由 compose 固定为 0.0.0.0
HOST=127.0.0.1

# ---- 数据 ----
DATA_DIR=./data

# ---- 时区 ----
# 容器默认是 UTC。日报的「每天几点（本地时间）」、统计页的按天分桶都跟着它走，
# 所以这里默认固定为北京时间；要按别的时区用就改成 IANA 名称（如 Asia/Tokyo）。
# Node 自带时区库，不需要装 tzdata。
TZ=Asia/Shanghai

# ---- 游戏 ----
# 测试服：https://test.reelax.cn
REELAX_BASE_URL=https://reelax.cn
# 无代理账号的兜底出口（可选）
REELAX_GLOBAL_PROXY=
# 出口 IP 探测地址（代理连通性测试用）
PROXY_ECHO_URL=https://api.ipify.org?format=json

# ---- 反向代理 / HTTPS ----
# 只有在 Nginx/Caddy 之后部署时才设为 1（用于限流与审计取真实 IP）。
# ★ 设为 1 时**必须让反代覆盖** X-Forwarded-For，否则客户端可以自己伪造 IP：
#     nginx: proxy_set_header X-Forwarded-For $remote_addr;
#   默认 0（直连）：此时 cookie/IP 都取自 TCP 对端，无法伪造。
TRUST_PROXY=0
# cookie 的 Secure 策略（三态）：
#   不设置（默认）= 按每次请求的实际协议自动判断 —— 推荐，http/https 都能正常工作
#   1 = 强制加 Secure（必须整站 HTTPS；只做 80 端口反代会「登录成功但立刻掉线」）
#   0 = 强制不加
COOKIE_SECURE=

# ---- 注册与配额 ----
# 注册只需要邀请码，用邀请码注册后**直接可用**（无审批环节）
ALLOW_REGISTRATION=1
MAX_ACCOUNTS_PER_USER=5
MAX_RUNNING_ACCOUNTS=50

# ---- 部署时的默认管理员 ----
# 启动时自动确保存在这个管理员账号（纯后台角色，不挂游戏）。
# 口令留空 = 首次创建时随机生成，并在启动日志与 data/INITIAL_ADMIN.txt 里各打印一次。
# 填了值 = 每次启动都把这个管理员的口令重置成它（忘了口令时很有用）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 在线更新 ----
# 仓库地址（查询远端最新提交用）
REELAX_REPO=Creator2K/reelax-server
# 私有仓库需要 token 才能读到远端提交信息（可选）
GITHUB_TOKEN=
# 旁路更新器地址。启用 update profile 后设为 http://updater:9000
REELAX_UPDATER_URL=
# 额外令牌（可选，与 updater 的 UPDATER_TOKEN 一致）
UPDATER_TOKEN=
# 是否允许本进程直接 git pull + 重建。
# Docker 部署必须为 0（代码在镜像里，改不了自己）；本地 node 运行可设 1
ALLOW_LOCAL_UPDATE=0
# 宿主机仓库目录（仅 updater 挂载用）
REELAX_PROJECT_DIR=.

# ---- 日志 ----
# debug / info / warn / error
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# ---- 会话 ----
SESSION_TTL_DAYS=30
