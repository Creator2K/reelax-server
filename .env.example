# ---- 必填 ----
# 凭证加密主密钥：openssl rand -hex 32
# ★ 必须长期保存！弄丢之后数据库里的游戏密码 / Cookie / 推送 SendKey 全部无法解密。
MASTER_KEY=

# ---- 监听 ----
PORT=8580
# 本地裸跑建议 127.0.0.1；Docker 里由 compose 固定为 0.0.0.0
HOST=127.0.0.1

# ---- 数据 ----
DATA_DIR=./data

# ---- 游戏 ----
# 测试服：https://test.reelax.cn
REELAX_BASE_URL=https://reelax.cn
# 无代理账号的兜底出口（可选）
REELAX_GLOBAL_PROXY=
# 出口 IP 探测地址（代理连通性测试用）
PROXY_ECHO_URL=https://api.ipify.org?format=json

# ---- 反向代理 / HTTPS ----
# 在 Nginx/Caddy 之后部署时打开，用于限流取真实 IP
TRUST_PROXY=0
# cookie 的 Secure 策略（三态）：
#   不设置（默认）= 按每次请求的实际协议自动判断 —— 推荐，http/https 都能正常工作
#   1 = 强制加 Secure（必须整站 HTTPS；只做 80 端口反代会「登录成功但立刻掉线」）
#   0 = 强制不加
COOKIE_SECURE=

# ---- 注册与配额 ----
# 注册只需要邀请码，用邀请码注册后**直接可用**（无审批环节）
ALLOW_REGISTRATION=1
MAX_ACCOUNTS_PER_USER=5
MAX_RUNNING_ACCOUNTS=50

# ---- 在线更新 ----
# 仓库地址（查询远端最新提交用）
REELAX_REPO=Creator2K/reelax-server
# 私有仓库需要 token 才能读到远端提交信息（可选）
GITHUB_TOKEN=
# 旁路更新器地址。启用 update profile 后设为 http://updater:9000
REELAX_UPDATER_URL=
# 额外令牌（可选，与 updater 的 UPDATER_TOKEN 一致）
UPDATER_TOKEN=
# 是否允许本进程直接 git pull + 重建。
# Docker 部署必须为 0（代码在镜像里，改不了自己）；本地 node 运行可设 1
ALLOW_LOCAL_UPDATE=0
# 宿主机仓库目录（仅 updater 挂载用）
REELAX_PROJECT_DIR=.

# ---- 日志 ----
# debug / info / warn / error
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# ---- 会话 ----
SESSION_TTL_DAYS=30
