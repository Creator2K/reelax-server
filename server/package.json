{
  "name": "@reelax/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --watch-path=src --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "undici": "^7.13.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5",
    "socks": "^2.8.7",
    "@wechatbot/wechatbot": "^2.2.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
